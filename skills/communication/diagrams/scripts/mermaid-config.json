    "primaryTextColor": "#4A2870",
    "lineColor": "#4A6070",
    "secondaryColor": "#E8EEF2",
    "tertiaryColor": "#FFFFFF",
    "clusterBkg": "#F5F8FA",
    "clusterBorder": "#7D93A3",
    "edgeLabelBackground": "#FFFFFF",
    "actorBkg": "#EFE7F7",
    "actorBorder": "#6A3D96",

# Copy to .target.env (gitignored) and fill in.

# A Host entry from ~/.ssh/config, or user@ip (key-based login, no password prompt).
TARGET_HOST=my-board

# Expected `hostname` of the board. If set, sync refuses to run against any other
# machine (protects against DHCP IP shifts landing on a different board).
TARGET_HOSTNAME=

# Absolute path of this project on the board.
TARGET_DIR=/home/user/projects/my-project

# Build command run in TARGET_DIR on the board.
BUILD_CMD='cmake -S . -B build -DCMAKE_BUILD_TYPE=Release && cmake --build build -j$(nproc)'

# Default remote path for `./target.sh pull`.
REMOTE_OUT=outputs

# Set to 1 to let `sync` delete files on the board that no longer exist on the host.
SYNC_DELETE=0
